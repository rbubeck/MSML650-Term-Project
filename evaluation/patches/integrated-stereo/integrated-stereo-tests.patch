+describe('stereo capture race-condition diagnostics', () => {
+  afterEach(() => {
+    vi.useRealTimers();
+    vi.unstubAllGlobals();
+  });
+
+  it('waits for resource cleanup across concurrent stop requests', async () => {
+    vi.useFakeTimers();
+
+    const test = setupProcessing();
+
+    await test.capture.acquire();
+    await test.capture.startProcessing();
+
+    // Hold all flush acknowledgments until explicitly released.
+    test.port.postMessage.mockImplementation(() => undefined);
+
+    let firstStopResolved = false;
+    let secondStopResolved = false;
+
+    const firstStop = test.capture.stop().then(() => {
+      firstStopResolved = true;
+    });
+
+    const secondStop = test.capture.stop().then(() => {
+      secondStopResolved = true;
+    });
+
+    // Allow pending promise callbacks to execute.
+    await Promise.resolve();
+    await Promise.resolve();
+
+    const firstResolvedBeforeCleanup = firstStopResolved;
+    const secondResolvedBeforeCleanup = secondStopResolved;
+
+    const closedBeforeFlush = test.context.close.mock.calls.length;
+
+    const flushRequests = test.port.postMessage.mock.calls.filter(
+      ([message]) => message.type === 'flush',
