{
  "name": "@live-transcription/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build --workspace @live-transcription/contracts && tsc --project tsconfig.build.json",
    "bundle:smoke": "npm run build && esbuild dist/smoke-test-lambda.js --bundle --platform=node --target=node24 --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --sourcemap --outfile=dist/smoke/index.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --root ../.. backend/api"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@live-transcription/contracts": "*",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
