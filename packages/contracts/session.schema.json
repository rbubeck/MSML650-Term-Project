{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/v1/session.schema.json",
  "title": "SessionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "name",
    "status",
    "languageCode",
    "audio",
    "createdAt",
    "startedAt",
    "endedAt",
    "durationMs",
    "latestStreamEpoch",
    "version",
    "failure",
    "exports"
  ],
  "properties": {
    "sessionId": {"type": "string", "pattern": "^sess_[A-Za-z0-9_-]+$", "maxLength": 128},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "status": {
      "enum": ["CREATED", "CONNECTING", "STREAMING", "FINALIZING", "COMPLETED", "INTERRUPTED", "FAILED", "DELETING"]
    },
    "languageCode": {"type": "string", "pattern": "^[a-z]{2,3}-[A-Z]{2}$"},
    "audio": {"$ref": "#/$defs/audio"},
    "createdAt": {"type": "string", "format": "date-time"},
    "startedAt": {"type": ["string", "null"], "format": "date-time"},
    "endedAt": {"type": ["string", "null"], "format": "date-time"},
    "durationMs": {"type": "integer", "minimum": 0},
    "latestStreamEpoch": {"type": "integer", "minimum": 0},
    "version": {"type": "integer", "minimum": 1},
    "failure": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "retryable"],
          "properties": {
            "code": {"type": "string", "maxLength": 80},
            "retryable": {"type": "boolean"}
          }
        }
      ]
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "status"],
        "properties": {
          "format": {"enum": ["json", "txt"]},
          "status": {"enum": ["PENDING", "READY", "FAILED"]}
        }
      }
    }
  },
  "$defs": {
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "sampleRateHz", "channels", "chunkDurationMs"],
      "properties": {
        "encoding": {"const": "pcm_s16le"},
        "sampleRateHz": {"const": 16000},
        "channels": {"const": 1},
        "chunkDurationMs": {"type": "integer", "minimum": 50, "maximum": 200}
      }
    }
  }
}
